/dts-v1/;
#include "ipq6018-soc.dtsi"

/ {
	model = "QCA, IPQ6018-CP03-C1";
	compatible = "qca,ipq6018", "qca,ipq6018-cp03-c1";
	machid = <0x8030200>;
	config_name = "config@cp03-c1";
	qcom,msm-id = <0x192 0x00>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	interrupt-parent = <&intc>;

	aliases {
		sdhc1 = "/soc/sdhci@7804000";
		ethernet0 = "/soc/dp1";
		ethernet1 = "/soc/dp2";
		ethernet2 = "/soc/dp3";
		ethernet3 = "/soc/dp4";
		ethernet4 = "/soc/dp5";
	};

	ess-switch {
		switch_cpu_bmp = <0x1>;  /* cpu port bitmap */
		switch_lan_bmp = <0x1e>; /* lan port bitmap */
		switch_wan_bmp = <0x20>; /* wan port bitmap */
		switch_inner_bmp = <0xc0>; /*inner port bitmap*/
		switch_mac_mode = <0x0>; /* mac mode for uniphy 0*/
		switch_mac_mode1 = <0xff>; /* mac mode for uniphy 1*/
		switch_mac_mode2 = <0xff>; /* mac mode for uniphy 2*/

		qcom,port_phyinfo {
			port@0 {
				port_id = <1>;
				phy_address = <0>;
			};

			port@1 {
				port_id = <2>;
				phy_address = <1>;
			};

			port@2 {
				port_id = <3>;
				phy_address = <2>;
			};

			port@3 {
				port_id = <4>;
				phy_address = <3>;
			};

			port@4 {
				port_id = <5>;
				phy_address = <4>;
			};
		};
	};




};

